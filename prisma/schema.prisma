generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum SubscriptionTier {
  FREE
  PRO
  ELITE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  CORE
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
  FULL_BODY
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  BANDS
  SMITH_MACHINE
  TRAP_BAR
  OTHER
}

enum ExerciseCategory {
  COMPOUND
  ISOLATION
  CARDIO
  STRETCHING
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  PAUSED
}

enum WorkoutType {
  PUSH
  PULL
  LEGS
  UPPER
  LOWER
  FULL_BODY
  CARDIO
  CUSTOM
}

enum SetType {
  WARMUP
  WORKING
  DROPSET
  FAILURE
  MYOREP
  FEEDER
}

enum RecordType {
  WEIGHT
  REPS
  VOLUME
  ONE_RM
  ENDURANCE
}

enum SplitType {
  PPL
  UPPER_LOWER
  BRO_SPLIT
  FULL_BODY
  ARNOLD
  CUSTOM
}

enum PeriodizationType {
  LINEAR
  DUP
  BLOCK_ACCUMULATION
  BLOCK_INTENSIFICATION
  BLOCK_REALIZATION
  UNDULATING
}

enum AchievementTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum NotificationType {
  PR_ACHIEVED
  STREAK_MILESTONE
  WEEKLY_REPORT
  REMINDER
  ACHIEVEMENT_UNLOCKED
  CHALLENGE_UPDATE
  SOCIAL
}

// ─── Auth (NextAuth) ──────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User & Profile ───────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  subscriptionTier SubscriptionTier @default(FREE)

  /// Smartwatch da cui la sezione Benessere prende i dati (null: nessuno collegato)
  wellnessSource DeviceProvider?

  accounts Account[]
  sessions Session[]

  profile             Profile?
  preferences         Preferences?
  goals               Goal[]
  workoutSessions     WorkoutSession[]
  personalRecords     PersonalRecord[]
  bodyMeasurements    BodyMeasurement[]
  customExercises     Exercise[]
  programs            Program[]
  activeProgram       ActiveProgram?
  runActivities       RunActivity[]
  stravaConnection    StravaConnection?
  miFitnessConnection MiFitnessConnection?
  garminConnection    GarminConnection?
  wellnessDays        WellnessDay[]
  sleepSessions       SleepSession[]
  streak              Streak?
  achievements        UserAchievement[]
  notifications       Notification[]
  workoutShares       WorkoutShare[]

  following Follows[] @relation("Following")
  followers Follows[] @relation("Followers")

  @@index([email])
}

model Profile {
  id               String          @id @default(cuid())
  userId           String          @unique
  bio              String?         @db.Text
  avatarUrl        String?
  weight           Float?
  height           Float?
  birthDate        DateTime?
  experienceLevel  ExperienceLevel @default(BEGINNER)
  preferredUnits   String          @default("kg")
  /// Corsa: frequenze cardiache per il carico di allenamento e obiettivo settimanale
  maxHeartRate     Int?
  restingHeartRate Int?
  weeklyRunKmGoal  Float?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Preferences {
  id                 String   @id @default(cuid())
  userId             String   @unique
  units              String   @default("kg")
  theme              String   @default("dark")
  restTimerDefault   Int      @default(90)
  soundEnabled       Boolean  @default(true)
  vibrationEnabled   Boolean  @default(true)
  showRPE            Boolean  @default(true)
  showTempo          Boolean  @default(false)
  autoStartTimer     Boolean  @default(true)
  plateCalculatorBar Float    @default(20)
  availablePlates    Json     @default("[20,15,10,5,2.5,1.25]")
  weekStartDay       Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Goal {
  id                 String    @id @default(cuid())
  userId             String
  targetBodyWeight   Float?
  weeklyVolumeTarget Float?
  weeklyFrequency    Int?
  targetLift         String?
  targetLiftWeight   Float?
  targetLiftReps     Int?
  deadline           DateTime?
  achieved           Boolean   @default(false)
  achievedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Exercise Library ─────────────────────────────────────────────────────────

model Exercise {
  id                  String           @id @default(cuid())
  name                String
  nameIt              String?
  aliases             String[]
  description         String?          @db.Text
  instructions        String?          @db.Text
  videoUrl            String?
  imageUrl            String?
  category            ExerciseCategory @default(COMPOUND)
  muscleGroups        MuscleGroup[]
  primaryMuscle       MuscleGroup?
  equipment           Equipment[]
  // Coefficienti di contributo per muscolo, es. {"CHEST":1,"TRICEPS":0.5}
  muscleContributions Json?
  difficulty          Int              @default(3)
  tags                String[]
  isCustom            Boolean          @default(false)
  isPublic            Boolean          @default(true)
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  createdBy        User?             @relation(fields: [createdById], references: [id])
  workoutExercises WorkoutExercise[]
  personalRecords  PersonalRecord[]

  @@index([name])
  @@index([createdById])
  @@index([category])
}

// ─── Workout Session ──────────────────────────────────────────────────────────

model WorkoutSession {
  id                   String          @id @default(cuid())
  userId               String
  startedAt            DateTime        @default(now())
  endedAt              DateTime?
  duration             Int?
  status               SessionStatus   @default(ACTIVE)
  totalVolume          Float           @default(0)
  totalSets            Int             @default(0)
  totalReps            Int             @default(0)
  restSeconds          Int             @default(0)
  activeSeconds        Int?
  estimatedCalories    Int?
  rating               Int?
  rpe                  Float?
  notes                String?         @db.Text
  mood                 Int?
  energyLevel          Int?
  workoutType          WorkoutType     @default(CUSTOM)
  muscleGroupsTargeted MuscleGroup[]
  location             String?
  latitude             Float?
  longitude            Float?
  templateId           String?
  programDayId         String?
  /// Stato dell'allenamento in corso (esercizi e serie, anche non spuntate),
  /// salvato mentre ti alleni: si riprende anche se il telefono perde i dati.
  draft                Json?
  /// Seduta importata da uno smartwatch (palestra, bici…); null se registrata nell'app
  source               ActivitySource?
  /// Id dell'attività sulla fonte: la stessa attività non si importa due volte
  externalId           String?
  /// Nome dell'attività sulla fonte (es. "Giro in bici")
  title                String?
  /// Tipo di attività importata: Strength, Ride, Walk, Swim…
  sportType            String?
  /// metri, attività con distanza (bici, camminata, nuoto…)
  distance             Float?
  avgHeartRate         Float?
  maxHeartRate         Float?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]
  personalRecords PersonalRecord[]
  share           WorkoutShare?
  /// Se la seduta è una corsa, qui ci sono i dettagli
  run             RunActivity?

  @@unique([userId, source, externalId])
  @@index([userId, startedAt])
  @@index([userId, status])
}

model WorkoutExercise {
  id               String   @id @default(cuid())
  sessionId        String
  exerciseId       String
  orderIndex       Int      @default(0)
  restTimerSeconds Int      @default(90)
  restAfterSeconds Int?
  workSeconds      Int?
  notes            String?  @db.Text
  supersetWith     String?
  createdAt        DateTime @default(now())

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
  sets     Set[]

  @@index([sessionId])
  @@index([exerciseId])
}

model Set {
  id                String   @id @default(cuid())
  workoutExerciseId String
  setNumber         Int
  type              SetType  @default(WORKING)
  reps              Int?
  weight            Float?
  rpe               Float?
  tempo             String?
  duration          Int?
  distance          Float?
  isPR              Boolean  @default(false)
  volume            Float    @default(0)
  restSeconds       Int?
  notes             String?
  completedAt       DateTime @default(now())

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutExerciseId])
}

// ─── Personal Records ─────────────────────────────────────────────────────────

model PersonalRecord {
  id                 String     @id @default(cuid())
  userId             String
  exerciseId         String
  recordType         RecordType
  value              Float
  reps               Int?
  weight             Float?
  dateAchieved       DateTime   @default(now())
  previousRecord     Float?
  improvementPercent Float?
  workoutSessionId   String?
  createdAt          DateTime   @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id])
  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id])

  @@index([userId, exerciseId])
  @@index([userId, dateAchieved])
}

// ─── Body Measurements ────────────────────────────────────────────────────────

model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @default(now())
  weight     Float?
  bodyFat    Float?
  muscleMass Float?
  chest      Float?
  arms       Float?
  waist      Float?
  hips       Float?
  thighs     Float?
  calves     Float?
  neck       Float?
  shoulders  Float?
  notes      String?  @db.Text
  photos     String[]
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ─── Programs & Routines ──────────────────────────────────────────────────────

model Program {
  id            String            @id @default(cuid())
  name          String
  description   String?           @db.Text
  creatorId     String
  isPublic      Boolean           @default(false)
  isTemplate    Boolean           @default(false)
  frequency     Int               @default(3)
  splitType     SplitType         @default(CUSTOM)
  periodization PeriodizationType @default(LINEAR)
  durationWeeks Int               @default(8)
  tags          String[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  creator     User            @relation(fields: [creatorId], references: [id])
  days        ProgramDay[]
  activations ActiveProgram[]

  @@index([creatorId])
  @@index([isPublic, isTemplate])
}

model ProgramDay {
  id          String            @id @default(cuid())
  programId   String
  dayIndex    Int
  name        String
  workoutType WorkoutType       @default(CUSTOM)
  exercises   ProgramExercise[]

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model ProgramExercise {
  id          String  @id @default(cuid())
  dayId       String
  exerciseId  String
  orderIndex  Int     @default(0)
  sets        Int     @default(3)
  repsMin     Int     @default(8)
  repsMax     Int     @default(12)
  rpe         Float?
  percentage  Float?
  restSeconds Int     @default(90)
  notes       String?

  day ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@index([dayId])
}

model ActiveProgram {
  id          String    @id @default(cuid())
  userId      String    @unique
  programId   String
  startedAt   DateTime  @default(now())
  currentWeek Int       @default(1)
  currentDay  Int       @default(0)
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id])
}

// ─── Streak & Gamification ────────────────────────────────────────────────────

model Streak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastWorkoutDate DateTime?
  graceUsed       Boolean   @default(false)
  totalWorkouts   Int       @default(0)
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  iconEmoji   String
  tier        AchievementTier @default(BRONZE)
  xpReward    Int             @default(50)
  criteria    Json

  userAchievements UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())
  progress      Float    @default(0)
  completed     Boolean  @default(false)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@index([userId])
}

// ─── Social ───────────────────────────────────────────────────────────────────

model Follows {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model WorkoutShare {
  id        String   @id @default(cuid())
  userId    String
  sessionId String   @unique
  caption   String?  @db.Text
  isPublic  Boolean  @default(false)
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isPublic, createdAt])
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ─── Data provisioning ────────────────────────────────────────────────────────

// Interventi sui dati eseguiti una sola volta al deploy (es. caricare una scheda
// e attivarla). La riga marca l'intervento come applicato: i deploy successivi
// non lo ripetono, così le scelte fatte dall'app non vengono sovrascritte.
model DataProvision {
  key       String   @id
  appliedAt DateTime @default(now())
}

// ─── Corsa ────────────────────────────────────────────────────────────────────

enum ActivitySource {
  STRAVA
  MI_FITNESS
  GARMIN
  GPX
  MANUAL
}

/// Smartwatch collegabili: ognuno porta corse e dati benessere
enum DeviceProvider {
  MI_FITNESS
  GARMIN
}

/// Una corsa. Ha sempre una WorkoutSession (CARDIO) collegata, così conta come
/// allenamento per streak, calendario e statistiche settimanali.
model RunActivity {
  id            String         @id @default(cuid())
  userId        String
  sessionId     String         @unique
  source        ActivitySource
  /// Id dell'attività sulla piattaforma di origine (es. Strava)
  externalId    String?
  name          String
  sportType     String         @default("Run")
  startedAt     DateTime
  /// metri
  distance      Float
  /// secondi in movimento / totali
  movingTime    Int
  elapsedTime   Int
  elevationGain Float?
  avgHeartRate  Float?
  maxHeartRate  Float?
  /// passi al minuto
  avgCadence    Float?
  calories      Float?
  /// Percorso in formato encoded polyline (Google)
  polyline      String?        @db.Text
  /// [{ km, seconds, distance, elevation, heartRate }]
  splits        Json?
  /// [{ name, distance, seconds }]
  bestEfforts   Json?
  /// true quando sono stati letti split e migliori tempi (dettaglio completo)
  detailed      Boolean        @default(false)
  trainingLoad  Float?
  notes         String?        @db.Text
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([userId, source, externalId])
  @@index([userId, startedAt])
}

/// Collegamento a Strava. I token sono cifrati (vedi lib/crypto).
model StravaConnection {
  id           String    @id @default(cuid())
  userId       String    @unique
  athleteId    String    @unique
  athleteName  String?
  accessToken  String    @db.Text
  refreshToken String    @db.Text
  expiresAt    DateTime
  scope        String?
  lastSyncAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Collegamento all'account Xiaomi (Mi Fitness) tramite passToken, mai la password
model MiFitnessConnection {
  id                  String    @id @default(cuid())
  userId              String    @unique
  xiaomiId            String    @unique
  /// passToken cifrato (AES-256-GCM)
  passToken           String    @db.Text
  /// Regione del cloud salute (de per l'Europa)
  region              String    @default("de")
  lastSyncAt          DateTime?
  lastError           String?
  /// Dati benessere (sonno, battiti…) scaricati fino a questo istante
  wellnessSyncedUntil DateTime?
  /// …e a ritroso fino a questo (storico iniziale)
  wellnessSyncedFrom  DateTime?
  /// Battiti al minuto: scaricati a parte, giorno per giorno
  wellnessHrFrom      DateTime?
  wellnessHrUntil     DateTime?
  /// Fuso dell'orologio (secondi): i giorni locali si scaricano senza margini
  wellnessZoneOffset  Int?
  /// Ultimo errore di un tipo di dato (diagnostica, non blocca)
  wellnessError       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Collegamento a Garmin Connect con la Personal API ufficiale (chiave personale, sola lettura)
model GarminConnection {
  id                   String    @id @default(cuid())
  userId               String    @unique
  /// Chiave personale cifrata (AES-256-GCM): da connect.garmin.com, scade a 30 giorni - 1 anno
  apiKey               String    @db.Text
  /// Token di accesso (JWT, 24 h) cifrato: si riusa finché vale
  accessToken          String?   @db.Text
  accessTokenExpiresAt DateTime?
  displayName          String?
  /// Fuso del profilo Garmin (es. Europe/Rome): ore locali della curva dei battiti
  timeZone             String?
  lastSyncAt           DateTime?
  lastError            String?
  /// Dati benessere scaricati fino a / a ritroso da questo giorno
  wellnessSyncedUntil  DateTime?
  wellnessSyncedFrom   DateTime?
  /// Battiti al minuto: scaricati a parte, giorno per giorno
  wellnessHrFrom       DateTime?
  wellnessHrUntil      DateTime?
  /// Ultimo errore di un tipo di dato (diagnostica, non blocca)
  wellnessError        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Benessere (smartwatch) ───────────────────────────────────────────────────

/// Riepilogo di un giorno dallo smartwatch: aggregati, non i campioni al minuto
model WellnessDay {
  id             String         @id @default(cuid())
  userId         String
  /// Orologio che ha misurato il giorno: si mostra quello scelto dall'utente
  source         DeviceProvider @default(MI_FITNESS)
  /// Giorno locale dell'orologio (yyyy-MM-dd)
  date           String
  steps          Int?
  /// metri
  distance       Float?
  activeCalories Float?
  restingHr      Int?
  avgHr          Int?
  minHr          Int?
  maxHr          Int?
  /// [{ h, avg, min, max }] frequenza cardiaca per ora
  hrHourly       Json?
  spo2Avg        Float?
  spo2Min        Float?
  stressAvg      Int?
  stressMax      Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, date])
}

/// Una notte (o un pisolino) registrata dall'orologio
model SleepSession {
  id         String         @id @default(cuid())
  userId     String
  externalId String
  source     DeviceProvider @default(MI_FITNESS)
  /// Giorno locale del risveglio (yyyy-MM-dd)
  date       String
  startAt    DateTime
  endAt      DateTime
  /// minuti: a letto, addormentato e per fase
  duration   Int
  asleep     Int
  deep       Int?
  light      Int?
  rem        Int?
  awake      Int?
  score      Int?
  isNap      Boolean        @default(false)
  avgHr      Int?
  minHr      Int?
  maxHr      Int?
  /// respiri al minuto (media della notte)
  respRate   Float?
  /// risvegli durante la notte
  awakeCount Int?
  /// [{ stage, start, end }] (secondi epoch) per l'ipnogramma
  stages     Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, externalId])
  @@index([userId, source, date])
}
