# ─── Database ─────────────────────────────────────────────────────────────────
# Neon/Vercel generate postgres:// — prisma.ts and scripts/migrate.mjs
# automatically normalize it to postgresql://, no manual fix needed.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Setup endpoint ───────────────────────────────────────────────────────────
# Used by POST /api/setup to seed exercises + achievements after first deploy.
# Generate with: openssl rand -base64 32
SETUP_SECRET="your-setup-secret"

# ─── Coach AI ─────────────────────────────────────────────────────────────────
# Chiave dell'API di Anthropic (console.anthropic.com). Solo lato server.
ANTHROPIC_API_KEY=""
# Proprietario del Coach (accesso sempre attivo): id utente separati da virgole (non email).
# I tester si aggiungono dall'app (/coach/admin) con inviti o dalla lista d'attesa.
COACH_FREE_USER_IDS=""
# Facoltativi:
# - chi gestisce inviti e tester (default: COACH_FREE_USER_IDS)
COACH_ADMIN_USER_IDS=""
# - impegno del modello (low|medium|high|xhigh|max, default medium)
COACH_EFFORT=""
# - messaggi al giorno: proprietario (default 150) e ogni tester (default 30)
COACH_DAILY_LIMIT=""
COACH_TESTER_DAILY_LIMIT=""
