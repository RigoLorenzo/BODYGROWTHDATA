# ─── Database ─────────────────────────────────────────────────────────────────
# Vercel Postgres (Neon) → vercel.com > Storage > Create Database
# Copia i valori "DATABASE_URL" e "DATABASE_URL_UNPOOLED" da Vercel
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Genera il secret con: openssl rand -base64 32
AUTH_SECRET="your-32-byte-random-secret"
# Su Vercel viene auto-rilevato; in locale imposta questo
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth ────────────────────────────────────────────────────────────────────
# Google → console.cloud.google.com > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: https://TUODOMINIO.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub → github.com/settings/developers > OAuth Apps > New OAuth App
# Authorization callback URL: https://TUODOMINIO.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Storage opzionale ────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""
