# ─── Database ─────────────────────────────────────────────────────────────────
# Neon/Vercel generate postgres:// — prisma.ts and scripts/migrate.mjs
# automatically normalize it to postgresql://, no manual fix needed.
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host/neondb?sslmode=require"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── OAuth ────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Setup endpoint ───────────────────────────────────────────────────────────
# Used by POST /api/setup to seed exercises + achievements after first deploy.
# Generate with: openssl rand -base64 32
SETUP_SECRET="your-setup-secret"
